{
  "datasets": [
    {
      "name": "6662ebcc",
      "displayName": "radar_mercado",
      "config": {
        "version": "1.1",
        "source": "workspace.default.radar_mercado",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "7cc50b46",
      "displayName": "Filtered Signal Count Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(*) AS registros_sinalizados\r\n",
        "FROM workspace.default.radar_mercado\r\n",
        "WHERE classificacao <> 'Sem sinalizacao';"
      ]
    },
    {
      "name": "e579c910",
      "displayName": "Unique Ticker Count Analysis",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(DISTINCT ticker) AS ativos_analisados\r\n",
        "    FROM workspace.default.radar_mercado;"
      ]
    },
    {
      "name": "eb37afa8",
      "displayName": "Market Signal Insights with Price and Volume Trends",
      "queryLines": [
        "SELECT\r\n",
        "    ticker,\r\n",
        "    data_pregao,\r\n",
        "    preco_ultimo,\r\n",
        "    retorno_diario_pct,\r\n",
        "    volume_elevado,\r\n",
        "    razao_volume_20,\r\n",
        "    classificacao,\r\n",
        "    CASE\r\n",
        "        WHEN classificacao = 'Preco e volume expressivos' THEN 1\r\n",
        "        WHEN classificacao = 'Variacao expressiva de preco' THEN 2\r\n",
        "        WHEN classificacao = 'Volume elevado' THEN 3\r\n",
        "        ELSE 4\r\n",
        "    END AS prioridade\r\n",
        "FROM workspace.default.radar_mercado\r\n",
        "WHERE classificacao <> 'Sem sinalizacao'\r\n",
        "ORDER BY\r\n",
        "    prioridade ASC,\r\n",
        "    ABS(retorno_diario_pct) DESC,\r\n",
        "    razao_volume_20 DESC"
      ]
    },
    {
      "name": "ba0783ec",
      "displayName": "Daily Market Returns by Ticker and Trading Date",
      "queryLines": [
        "SELECT\r\n",
        "    data_pregao,\r\n",
        "    ticker,\r\n",
        "    retorno_diario_pct\r\n",
        "FROM workspace.default.radar_mercado\r\n",
        "WHERE retorno_diario_pct IS NOT NULL\r\n",
        "ORDER BY data_pregao, ticker;"
      ]
    }
  ],
